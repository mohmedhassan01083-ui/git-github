<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- ===================================================== -->
    <!-- MATERIAL FORM VIEW -->
    <!-- ===================================================== -->

    <record id="construction_material_form_view"
            model="ir.ui.view">

        <field name="name">estate.construction.material.form</field>
        <field name="model">estate.construction.material</field>

        <field name="arch" type="xml">

            <form string="Construction Material">

                <sheet>

                    <div class="oe_title">
                        <label for="name"
                               class="oe_edit_only"/>

                        <h1>
                            <field name="name"
                                   placeholder="Material Name"/>
                        </h1>
                    </div>

                    <!-- ========================= -->
                    <!-- BASIC INFORMATION -->
                    <!-- ========================= -->

                    <group string="Material Information">

                        <group>

                            <field name="name"/>

                            <field name="material_code"/>

                            <field name="project_id"/>

                            <field name="category"/>

                            <field name="description"/>

                        </group>

                        <group>

                            <field name="property_id"/>

                            <field name="building_name"/>

                            <field name="date"/>

                            <field name="purchase_date"/>

                        </group>

                    </group>


                    <!-- ========================= -->
                    <!-- QUANTITY & PRICE -->
                    <!-- ========================= -->

                    <group string="Quantity &amp; Pricing">

                        <group>

                            <field name="quantity"/>

                            <field name="unit"/>

                            <field name="unit_price"/>

                            <field name="waste_percentage"/>

                        </group>

                        <group>

                            <field name="subtotal"
                                   readonly="1"/>

                            <field name="waste_quantity"
                                   readonly="1"/>

                            <field name="total_quantity"
                                   readonly="1"/>

                            <field name="total_cost"
                                   readonly="1"/>

                        </group>

                    </group>


                    <!-- ========================= -->
                    <!-- SUPPLIER -->
                    <!-- ========================= -->

                    <group string="Supplier Information">

                        <group>

                            <field name="supplier_id"/>

                            <field name="supplier_invoice_number"/>

                        </group>

                        <group>

                            <field name="product_id"/>

                            <field name="stock_location_id"/>

                        </group>

                    </group>


                    <!-- ========================= -->
                    <!-- PAYMENT -->
                    <!-- ========================= -->

                    <group string="Payment">

                        <group>

                            <field name="paid_amount"/>

                            <field name="remaining_amount"
                                   readonly="1"/>

                        </group>

                    </group>


                    <!-- ========================= -->
                    <!-- NOTES -->
                    <!-- ========================= -->

                    <group string="Notes">

                        <field name="notes"/>

                    </group>

                </sheet>

            </form>

        </field>

    </record>


    <!-- ===================================================== -->
    <!-- MATERIAL LIST VIEW -->
    <!-- ===================================================== -->

    <record id="construction_material_tree_view"
            model="ir.ui.view">

        <field name="name">estate.construction.material.list</field>

        <field name="model">estate.construction.material</field>

        <field name="arch" type="xml">

            <list string="Construction Materials">

                <field name="name"/>

                <field name="material_code"/>

                <field name="project_id"/>

                <field name="category"/>

                <field name="property_id"/>

                <field name="building_name"/>

                <field name="quantity"/>

                <field name="unit"/>

                <field name="unit_price"/>

                <field name="waste_percentage"/>

                <field name="total_quantity"/>

                <field name="total_cost"/>

                <field name="supplier_id"/>

                <field name="paid_amount"/>

                <field name="remaining_amount"/>

                <field name="date"/>

            </list>

        </field>

    </record>


    <!-- ===================================================== -->
    <!-- MATERIAL ACTION -->
    <!-- ===================================================== -->

    <record id="construction_material_action"
            model="ir.actions.act_window">

        <field name="name">Construction Materials</field>

        <field name="res_model">estate.construction.material</field>

        <field name="view_mode">list,form</field>

    </record>


    <!-- ===================================================== -->
    <!-- MATERIAL MENU -->
    <!-- ===================================================== -->

    <menuitem
        id="construction_material_menu"
        name="Materials"
        parent="construction_menu"
        action="construction_material_action"
        sequence="20"/>

</odoo>