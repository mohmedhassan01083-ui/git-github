<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="action_property_report"
            model="ir.actions.report">

        <field name="name">Ultimate Code - Property Report</field>

        <field name="model">estate.property</field>

        <field name="report_type">qweb-pdf</field>

        <field name="report_name">test_addon.property_template</field>

        <field name="report_file">test_addon.property_template</field>

        <!-- Show report inside Print menu -->
        <field name="binding_model_id"
               ref="model_estate_property"/>

        <field name="binding_type">report</field>

        <field name="print_report_name">
            'Ultimate Code - Property Report'
        </field>

    </record>

</odoo>