<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- ===================================================== -->
    <!-- CONSTRUCTION PROJECT FORM -->
    <!-- ===================================================== -->

    <record id="construction_project_form_view"
            model="ir.ui.view">

        <field name="name">estate.construction.project.form</field>
        <field name="model">estate.construction.project</field>

        <field name="arch" type="xml">

            <form string="Construction Project">

                <!-- ========================= -->
                <!-- HEADER -->
                <!-- ========================= -->

                <header>

                    <button name="action_start_planning"
                            string="Start Planning"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_start_construction"
                            string="Start Construction"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'planning'"/>

                    <button name="action_complete"
                            string="Complete"
                            type="object"
                            class="btn-success"
                            invisible="state != 'construction'"/>

                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            class="btn-danger"
                            invisible="state in ('completed', 'cancelled')"/>

                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            class="btn-secondary"
                            invisible="state not in ('cancelled', 'completed')"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,planning,construction,completed,cancelled"/>

                </header>


                <!-- ========================= -->
                <!-- MAIN SHEET -->
                <!-- ========================= -->

                <sheet>

                    <!-- ========================= -->
                    <!-- PROJECT TITLE -->
                    <!-- ========================= -->

                    <div class="oe_title">

                        <label for="name"
                               class="oe_edit_only"/>

                        <h1>
                            <field name="name"
                                   placeholder="Construction Project Name"/>
                        </h1>

                    </div>


                    <!-- ========================= -->
                    <!-- PROJECT INFORMATION -->
                    <!-- ========================= -->

                    <group string="Project Information">

                        <group>

                            <field name="name"/>

                            <field name="code"/>

                            <field name="company_id"/>

                            <field name="start_date"/>

                        </group>

                        <group>

                            <field name="expected_end_date"/>

                            <field name="actual_end_date"/>

                            <field name="building_count"/>

                            <field name="unit_count"/>

                        </group>

                    </group>


                    <!-- ========================= -->
                    <!-- LAND INFORMATION -->
                    <!-- ========================= -->

                    <group string="Land Information">

                        <group>

                            <field name="land_area"/>

                            <field name="land_price"/>

                            <field name="land_price_per_meter"
                                   readonly="1"/>

                        </group>

                        <group>

                            <field name="land_registration_cost"/>

                            <field name="land_taxes"/>

                            <field name="land_broker_cost"/>

                            <field name="total_land_cost"
                                   readonly="1"/>

                        </group>

                    </group>


                    <!-- ========================= -->
                    <!-- BUILDING INFORMATION -->
                    <!-- ========================= -->

                    <group string="Building &amp; Area Information">

                        <group>

                            <field name="building_count"/>

                            <field name="unit_count"/>

                        </group>

                        <group>

                            <field name="total_built_area"/>

                            <field name="cost_per_meter"
                                   readonly="1"/>

                        </group>

                    </group>


                    <!-- ========================= -->
                    <!-- BUDGET -->
                    <!-- ========================= -->

                    <group string="Budget">

                        <group>

                            <field name="planned_budget"/>

                            <field name="contingency_percentage"/>

                            <field name="contingency_amount"
                                   readonly="1"/>

                        </group>

                        <group>

                            <field name="total_project_cost"
                                   readonly="1"/>

                            <field name="total_paid"/>

                            <field name="total_remaining"
                                   readonly="1"/>

                        </group>

                    </group>


                    <!-- ========================= -->
                    <!-- COST SUMMARY -->
                    <!-- ========================= -->

                    <group string="Cost Summary">

                        <group>

                            <field name="material_cost"
                                   readonly="1"/>

                            <field name="labor_cost"
                                   readonly="1"/>

                            <field name="equipment_cost"
                                   readonly="1"/>

                        </group>

                        <group>

                            <field name="expense_cost"
                                   readonly="1"/>

                            <field name="construction_cost"
                                   readonly="1"/>

                            <field name="total_project_cost"
                                   readonly="1"/>

                        </group>

                    </group>


                    <!-- ========================= -->
                    <!-- SALES & PROFIT -->
                    <!-- ========================= -->

                    <group string="Sales &amp; Profit">

                        <group>

                            <field name="expected_sales_value"/>

                            <field name="expected_profit"
                                   readonly="1"/>

                            <field name="expected_profit_percentage"
                                   readonly="1"/>

                        </group>

                        <group>

                            <field name="actual_sales_value"/>

                            <field name="actual_profit"
                                   readonly="1"/>

                            <field name="actual_profit_percentage"
                                   readonly="1"/>

                        </group>

                    </group>


                    <!-- ========================= -->
                    <!-- CONSTRUCTION PROGRESS -->
                    <!-- ========================= -->

                    <group string="Construction Progress">

                        <field name="progress_percentage"
                               widget="progressbar"/>

                    </group>


                    <!-- ========================= -->
                    <!-- TABS -->
                    <!-- ========================= -->

                    <notebook>

                        <!-- ========================= -->
                        <!-- MATERIALS -->
                        <!-- ========================= -->

                        <page string="Materials">

                            <field name="material_line_ids">

                                <list editable="bottom">

                                    <field name="name"/>

                                    <field name="material_code"/>

                                    <field name="category"/>

                                    <field name="property_id"/>

                                    <field name="building_name"/>

                                    <field name="quantity"/>

                                    <field name="unit"/>

                                    <field name="unit_price"/>

                                    <field name="waste_percentage"/>

                                    <field name="total_quantity"
                                           readonly="1"/>

                                    <field name="total_cost"
                                           readonly="1"/>

                                    <field name="paid_amount"/>

                                    <field name="remaining_amount"
                                           readonly="1"/>

                                    <field name="date"/>

                                </list>

                            </field>

                        </page>


                        <!-- ========================= -->
                        <!-- LABOR -->
                        <!-- ========================= -->

                        <page string="Labor">

                            <field name="labor_line_ids">

                                <list editable="bottom">

                                    <field name="name"/>

                                    <field name="worker_type"/>

                                    <field name="job_position"/>

                                    <field name="property_id"/>

                                    <field name="building_name"/>

                                    <field name="payment_type"/>

                                    <field name="work_days"/>

                                    <field name="hours_per_day"/>

                                    <field name="daily_rate"/>

                                    <field name="hourly_rate"/>

                                    <field name="fixed_amount"/>

                                    <field name="overtime_hours"/>

                                    <field name="overtime_rate"/>

                                    <field name="total_cost"
                                           readonly="1"/>

                                    <field name="paid_amount"/>

                                    <field name="remaining_amount"
                                           readonly="1"/>

                                    <field name="payment_status"
                                           readonly="1"/>

                                    <field name="date"/>

                                </list>

                            </field>

                        </page>


                        <!-- ========================= -->
                        <!-- EQUIPMENT -->
                        <!-- ========================= -->

                        <page string="Equipment">

                            <field name="equipment_line_ids">

                                <list editable="bottom">

                                    <field name="name"/>

                                    <field name="equipment_type"/>

                                    <field name="partner_id"/>

                                    <field name="property_id"/>

                                    <field name="building_name"/>

                                    <field name="payment_type"/>

                                    <field name="quantity"/>

                                    <field name="usage_days"/>

                                    <field name="hours_per_day"/>

                                    <field name="daily_rate"/>

                                    <field name="hourly_rate"/>

                                    <field name="fixed_amount"/>

                                    <field name="fuel_cost"/>

                                    <field name="maintenance_cost"/>

                                    <field name="transport_cost"/>

                                    <field name="operator_cost"/>

                                    <field name="total_cost"
                                           readonly="1"/>

                                    <field name="paid_amount"/>

                                    <field name="remaining_amount"
                                           readonly="1"/>

                                    <field name="payment_status"
                                           readonly="1"/>

                                    <field name="date"/>

                                </list>

                            </field>

                        </page>


                        <!-- ========================= -->
                        <!-- OTHER EXPENSES -->
                        <!-- ========================= -->

                        <page string="Other Expenses">

                            <field name="expense_line_ids">

                                <list editable="bottom">

                                    <field name="name"/>

                                    <field name="category"/>

                                    <field name="partner_id"/>

                                    <field name="property_id"/>

                                    <field name="building_name"/>

                                    <field name="amount"/>

                                    <field name="paid_amount"/>

                                    <field name="remaining_amount"
                                           readonly="1"/>

                                    <field name="payment_status"
                                           readonly="1"/>

                                    <field name="invoice_number"/>

                                    <field name="date"/>

                                </list>

                            </field>

                        </page>


                        <!-- ========================= -->
                        <!-- DESCRIPTION -->
                        <!-- ========================= -->

                        <page string="Description">

                            <field name="description"/>

                        </page>


                        <!-- ========================= -->
                        <!-- NOTES -->
                        <!-- ========================= -->

                        <page string="Notes">

                            <field name="notes"/>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>

    </record>


    <!-- ===================================================== -->
    <!-- CONSTRUCTION PROJECT LIST VIEW -->
    <!-- ===================================================== -->

    <record id="construction_project_tree_view"
            model="ir.ui.view">

        <field name="name">estate.construction.project.list</field>

        <field name="model">estate.construction.project</field>

        <field name="arch" type="xml">

            <list string="Construction Projects">

                <field name="name"/>

                <field name="code"/>

                <field name="company_id"/>

                <field name="land_area"/>

                <field name="building_count"/>

                <field name="unit_count"/>

                <field name="total_built_area"/>

                <field name="construction_cost"/>

                <field name="total_project_cost"/>

                <field name="cost_per_meter"/>

                <field name="expected_sales_value"/>

                <field name="expected_profit"/>

                <field name="progress_percentage"/>

                <field name="state"/>

            </list>

        </field>

    </record>


    <!-- ===================================================== -->
    <!-- CONSTRUCTION PROJECT ACTION -->
    <!-- ===================================================== -->

    <record id="construction_project_action"
            model="ir.actions.act_window">

        <field name="name">Construction Projects</field>

        <field name="res_model">estate.construction.project</field>

        <field name="view_mode">list,form</field>

    </record>


    <!-- ===================================================== -->
    <!-- CONSTRUCTION MENU -->
    <!-- ===================================================== -->

    <menuitem
        id="construction_menu"
        name="Construction"
        parent="estate_menu"
        sequence="40"/>


    <menuitem
        id="construction_project_menu"
        name="Construction Projects"
        parent="construction_menu"
        action="construction_project_action"
        sequence="10"/>

</odoo>