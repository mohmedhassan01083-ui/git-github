<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="action_sale_application_report"
            model="ir.actions.report">

        <field name="name">Ultimate Code - Sale Application</field>

        <field name="model">estate.sale.application</field>

        <field name="report_type">qweb-pdf</field>

        <field name="report_name">test_addon.sale_application_template</field>

        <field name="report_file">test_addon.sale_application_template</field>

        <field name="binding_model_id"
               ref="model_estate_sale_application"/>

        <field name="binding_type">report</field>

        <field name="print_report_name">
            'Ultimate Code - Sale Application - %s' % (object.customer_name)
        </field>

    </record>

</odoo>