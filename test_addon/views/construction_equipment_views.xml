<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- ===================================================== -->
    <!-- EQUIPMENT FORM VIEW -->
    <!-- ===================================================== -->

    <record id="construction_equipment_form_view"
            model="ir.ui.view">

        <field name="name">estate.construction.equipment.form</field>
        <field name="model">estate.construction.equipment</field>

        <field name="arch" type="xml">

            <form string="Construction Equipment">

                <sheet>

                    <div class="oe_title">

                        <label for="name"
                               class="oe_edit_only"/>

                        <h1>
                            <field name="name"
                                   placeholder="Equipment Name"/>
                        </h1>

                    </div>


                    <!-- ========================= -->
                    <!-- EQUIPMENT INFORMATION -->
                    <!-- ========================= -->

                    <group string="Equipment Information">

                        <group>

                            <field name="name"/>

                            <field name="equipment_type"/>

                            <field name="partner_id"/>

                            <field name="description"/>

                        </group>

                        <group>

                            <field name="project_id"/>

                            <field name="property_id"/>

                            <field name="building_name"/>

                            <field name="date"/>

                        </group>

                    </group>


                    <!-- ========================= -->
                    <!-- USAGE & PAYMENT -->
                    <!-- ========================= -->

                    <group string="Usage &amp; Payment">

                        <group>

                            <field name="payment_type"/>

                            <field name="quantity"/>

                            <field name="usage_days"/>

                            <field name="hours_per_day"/>

                            <field name="daily_rate"/>

                            <field name="hourly_rate"/>

                            <field name="fixed_amount"/>

                        </group>

                        <group>

                            <field name="start_date"/>

                            <field name="end_date"/>

                        </group>

                    </group>


                    <!-- ========================= -->
                    <!-- EXTRA COSTS -->
                    <!-- ========================= -->

                    <group string="Additional Costs">

                        <group>

                            <field name="fuel_cost"/>

                            <field name="maintenance_cost"/>

                            <field name="transport_cost"/>

                        </group>

                        <group>

                            <field name="operator_cost"/>

                            <field name="other_cost"/>

                        </group>

                    </group>


                    <!-- ========================= -->
                    <!-- COST SUMMARY -->
                    <!-- ========================= -->

                    <group string="Cost Summary">

                        <group>

                            <field name="base_cost"
                                   readonly="1"/>

                            <field name="extra_cost"
                                   readonly="1"/>

                        </group>

                        <group>

                            <field name="total_cost"
                                   readonly="1"/>

                            <field name="paid_amount"/>

                            <field name="remaining_amount"
                                   readonly="1"/>

                            <field name="payment_status"
                                   readonly="1"/>

                        </group>

                    </group>


                    <!-- ========================= -->
                    <!-- NOTES -->
                    <!-- ========================= -->

                    <group string="Notes">

                        <field name="notes"/>

                    </group>

                </sheet>

            </form>

        </field>

    </record>


    <!-- ===================================================== -->
    <!-- EQUIPMENT LIST VIEW -->
    <!-- ===================================================== -->

    <record id="construction_equipment_tree_view"
            model="ir.ui.view">

        <field name="name">estate.construction.equipment.list</field>

        <field name="model">estate.construction.equipment</field>

        <field name="arch" type="xml">

            <list string="Construction Equipment">

                <field name="date"/>

                <field name="name"/>

                <field name="equipment_type"/>

                <field name="partner_id"/>

                <field name="project_id"/>

                <field name="building_name"/>

                <field name="property_id"/>

                <field name="payment_type"/>

                <field name="quantity"/>

                <field name="usage_days"/>

                <field name="hours_per_day"/>

                <field name="daily_rate"/>

                <field name="hourly_rate"/>

                <field name="fixed_amount"/>

                <field name="fuel_cost"/>

                <field name="maintenance_cost"/>

                <field name="transport_cost"/>

                <field name="operator_cost"/>

                <field name="total_cost"/>

                <field name="paid_amount"/>

                <field name="remaining_amount"/>

                <field name="payment_status"/>

            </list>

        </field>

    </record>


    <!-- ===================================================== -->
    <!-- EQUIPMENT ACTION -->
    <!-- ===================================================== -->

    <record id="construction_equipment_action"
            model="ir.actions.act_window">

        <field name="name">Construction Equipment</field>

        <field name="res_model">estate.construction.equipment</field>

        <field name="view_mode">list,form</field>

    </record>


    <!-- ===================================================== -->
    <!-- EQUIPMENT MENU -->
    <!-- ===================================================== -->

    <menuitem
        id="construction_equipment_menu"
        name="Equipment"
        parent="construction_menu"
        action="construction_equipment_action"
        sequence="40"/>

</odoo>