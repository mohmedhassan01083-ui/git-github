<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- ===================================================== -->
    <!-- LABOR FORM VIEW -->
    <!-- ===================================================== -->

    <record id="construction_labor_form_view"
            model="ir.ui.view">

        <field name="name">estate.construction.labor.form</field>
        <field name="model">estate.construction.labor</field>

        <field name="arch" type="xml">

            <form string="Construction Labor">

                <sheet>

                    <div class="oe_title">

                        <label for="name"
                               class="oe_edit_only"/>

                        <h1>
                            <field name="name"
                                   placeholder="Worker / Contractor Name"/>
                        </h1>

                    </div>

                    <!-- ========================= -->
                    <!-- WORKER INFORMATION -->
                    <!-- ========================= -->

                    <group string="Worker Information">

                        <group>

                            <field name="name"/>

                            <field name="worker_type"/>

                            <field name="job_position"/>

                            <field name="partner_id"/>

                        </group>

                        <group>

                            <field name="project_id"/>

                            <field name="property_id"/>

                            <field name="building_name"/>

                            <field name="date"/>

                        </group>

                    </group>


                    <!-- ========================= -->
                    <!-- WORK DESCRIPTION -->
                    <!-- ========================= -->

                    <group string="Work Details">

                        <field name="description"/>

                    </group>


                    <!-- ========================= -->
                    <!-- PAYMENT CALCULATION -->
                    <!-- ========================= -->

                    <group string="Payment Calculation">

                        <group>

                            <field name="payment_type"/>

                            <field name="work_days"/>

                            <field name="hours_per_day"/>

                            <field name="daily_rate"/>

                            <field name="hourly_rate"/>

                            <field name="fixed_amount"/>

                        </group>

                        <group>

                            <field name="overtime_hours"/>

                            <field name="overtime_rate"/>

                            <field name="bonus"/>

                            <field name="transport_allowance"/>

                            <field name="accommodation_allowance"/>

                            <field name="other_allowance"/>

                            <field name="deductions"/>

                        </group>

                    </group>


                    <!-- ========================= -->
                    <!-- CALCULATED COST -->
                    <!-- ========================= -->

                    <group string="Cost Summary">

                        <group>

                            <field name="base_cost"
                                   readonly="1"/>

                            <field name="overtime_cost"
                                   readonly="1"/>

                            <field name="allowances_total"
                                   readonly="1"/>

                        </group>

                        <group>

                            <field name="total_cost"
                                   readonly="1"/>

                            <field name="paid_amount"/>

                            <field name="remaining_amount"
                                   readonly="1"/>

                            <field name="payment_status"
                                   readonly="1"/>

                        </group>

                    </group>


                    <!-- ========================= -->
                    <!-- WORK PERIOD -->
                    <!-- ========================= -->

                    <group string="Work Period">

                        <group>

                            <field name="start_date"/>

                            <field name="end_date"/>

                        </group>

                    </group>


                    <!-- ========================= -->
                    <!-- NOTES -->
                    <!-- ========================= -->

                    <group string="Notes">

                        <field name="notes"/>

                    </group>

                </sheet>

            </form>

        </field>

    </record>


    <!-- ===================================================== -->
    <!-- LABOR LIST VIEW -->
    <!-- ===================================================== -->

    <record id="construction_labor_tree_view"
            model="ir.ui.view">

        <field name="name">estate.construction.labor.list</field>

        <field name="model">estate.construction.labor</field>

        <field name="arch" type="xml">

            <list string="Construction Labor">

                <field name="date"/>

                <field name="name"/>

                <field name="worker_type"/>

                <field name="job_position"/>

                <field name="project_id"/>

                <field name="building_name"/>

                <field name="property_id"/>

                <field name="payment_type"/>

                <field name="work_days"/>

                <field name="hours_per_day"/>

                <field name="daily_rate"/>

                <field name="hourly_rate"/>

                <field name="fixed_amount"/>

                <field name="overtime_hours"/>

                <field name="overtime_rate"/>

                <field name="total_cost"/>

                <field name="paid_amount"/>

                <field name="remaining_amount"/>

                <field name="payment_status"/>

            </list>

        </field>

    </record>


    <!-- ===================================================== -->
    <!-- LABOR ACTION -->
    <!-- ===================================================== -->

    <record id="construction_labor_action"
            model="ir.actions.act_window">

        <field name="name">Construction Labor</field>

        <field name="res_model">estate.construction.labor</field>

        <field name="view_mode">list,form</field>

    </record>


    <!-- ===================================================== -->
    <!-- LABOR MENU -->
    <!-- ===================================================== -->

    <menuitem
        id="construction_labor_menu"
        name="Labor &amp; Contractors"
        parent="construction_menu"
        action="construction_labor_action"
        sequence="30"/>

</odoo>